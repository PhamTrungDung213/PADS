// Originally generated by unity-material-importer from Water_Orthor.shadergraph,
// then rewritten by hand as an unlit effect: the importer's Time / SimpleNoise /
// Depth_Orthographic nodes were unsupported and the generated surface shader
// flickered in the editor. Do not re-import over this file.
// Look: scrolling, distorted foam texture blended between color2 (deep) and color1 (shallow).
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: water-vs:vert
      frag: water-fs:frag
      properties:
        tilingOffset:    { value: [1.0, 1.0, 0.0, 0.0] }
        params:          { value: [0.15, 0.0, 0.0, 0.0], editor: { visible: false } }
        mainTexture:     { value: grey, editor: { displayName: Foam Tex } }
        distortStrenght: { value: 0.15, target: params.x, editor: { displayName: distort strenght } }
        stepIntersec:    { value: 0, target: params.y, editor: { displayName: Step Intersec? } }
        color1:          { value: [0.0156, 0.7725, 0.4549, 1], editor: { displayName: Color1, type: color } }
        color2:          { value: [0.0, 0.5765, 0.1608, 1], editor: { displayName: Color2, type: color } }
}%

CCProgram water-ubo %{
  uniform Constants {
    vec4 tilingOffset;
    vec4 params;
    vec4 color1;
    vec4 color2;
  };
}%

CCProgram water-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <water-ubo>

  out vec2 v_uv;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld;
    CCGetWorldMatrix(matWorld);

    v_uv = a_texCoord * tilingOffset.xy + tilingOffset.zw;
    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram water-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output>
  #include <water-ubo>

  in vec2 v_uv;
  uniform sampler2D mainTexture;

  vec4 frag () {
    float t = cc_time.x;
    // v_uv is already scaled by tilingOffset (material). Two counter-scrolling layers of the
    // caustic texture, warped by the first layer's own colour, keep the veins from looking static.
    vec2 warp = (texture(mainTexture, v_uv * 0.5 + vec2(t * 0.01, t * 0.015)).rb - 0.5) * params.x;
    float a = texture(mainTexture, v_uv + vec2(t * 0.02, t * 0.01) + warp).g;
    float b = texture(mainTexture, v_uv * 1.37 + vec2(-t * 0.015, t * 0.02) - warp).g;
    // The veins are the bright parts of the green channel; mask them out of the flat teal base.
    float foam = smoothstep(0.62, 0.95, (a + b) * 0.5);
    vec3 col = mix(color2.rgb, color1.rgb, foam);
    return CCFragOutput(vec4(col, 1.0));
  }
}%
