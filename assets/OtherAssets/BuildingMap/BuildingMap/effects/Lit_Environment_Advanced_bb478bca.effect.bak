CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: standard-vs
      frag: standard-fs
      rasterizerState:
        cullMode: none
      properties: &props
        tilingOffset:  { value: [1.0, 1.0, 0.0, 0.0] }
        mainTexture:  { value: grey, editor: { displayName: Base Map } }
        tintColor:  { value: [0.7577, 1.498, 0.1528, 1.0], editor: { displayName: Tint Color (Color ID Easy) } }
    - &shadow-caster
      vert: shadow-caster-vs
      frag: shadow-caster-fs
      phase: shadow-caster
      propertyIndex: 0
      rasterizerState:
        cullMode: front
}%

CCProgram shared-ubos %{
  uniform Constants {
    vec4 tilingOffset;
    vec4 tintColor;
  };
}%

CCProgram macro-remapping %{
  #pragma define-meta USE_TWOSIDE
  #define CC_SURFACES_USE_TWO_SIDED USE_TWOSIDE
}%

CCProgram surface-vertex %{
  #define CC_SURFACES_VERTEX_MODIFY_UV
  void SurfacesVertexModifyUV(inout SurfacesStandardVertexIntermediate In)
  {
    In.texCoord = In.texCoord * tilingOffset.xy + tilingOffset.zw;
  }
}%

CCProgram surface-fragment %{
  uniform sampler2D mainTexture;

  vec4 SRGBToLinearTex(vec4 c) { return vec4(SRGBToLinear(c.rgb), c.a); }





  #define CC_SURFACES_FRAGMENT_MODIFY_BASECOLOR_AND_TRANSPARENCY
  vec4 SurfacesFragmentModifyBaseColorAndTransparency()
  {
    // Hand-written from the shader graph's DecodeAlphaMask / TintMaskColor nodes: the texture's
    // alpha is a mask (>= 0.9 means "tint this texel"), and fully transparent texels are cut out.
    vec4 tex = texture(mainTexture, FSInput_texcoord);
    if (tex.a < 0.61) discard; // _AlphaClipping on the Unity material
    vec3 base = SRGBToLinear(tex.rgb);
    return vec4(mix(base, base * tintColor.rgb, step(0.9, tex.a)), 1.0);
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_EMISSIVE
  vec3 SurfacesFragmentModifyEmissive()
  {
    return vec3(0.0);
  }

  #define CC_SURFACES_FRAGMENT_MODIFY_PBRPARAMS
  vec4 SurfacesFragmentModifyPBRParams()
  {
    // x: occlusion, y: roughness, z: metallic, w: specular
    return vec4(1.0, 0.5, 0.0, 0.5);
  }
}%

